<Window
    x:Class="FluentPrayerTimes.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image x:Name="ImgTitle" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Text="Fluent Prayer Times" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        OpenPaneLength="200" IsPaneOpen="False"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="المواقيت" Tag="times">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE823;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="التقويم الهجري" Tag="calendar">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE787;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="محول التاريخ" Tag="convert">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="منبه الأذكار" Tag="azkar">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEA8F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="الإعدادات" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="عن البرنامج" Tag="about">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <!-- ===== Times page ===== -->
                <ScrollViewer x:Name="PageTimes" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="PanelTimes" Spacing="10" Padding="0,8,0,14" HorizontalAlignment="Center" FlowDirection="RightToLeft">
                        <StackPanel Spacing="2">
                            <TextBlock Text="مواقيت الصلاة" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtCity" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TxtDates" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16,12,16,12">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="TxtNextLabel" Text="الصلاة القادمة" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock x:Name="TxtNextName" Text="--" FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtNextTime" Text="" FontSize="16" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                               FlowDirection="LeftToRight" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" FlowDirection="LeftToRight" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock x:Name="TxtUnit" Text="" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtCountdown" Text="--:--" FontSize="40" FontWeight="SemiBold"
                                               FlowDirection="LeftToRight" VerticalAlignment="Center"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="TxtStatus" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,8,10,8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="مواقيت اليوم" FontSize="16" FontWeight="SemiBold" Margin="8,2,8,4" />
                                <StackPanel x:Name="RowsPanel" Spacing="2" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Calendar / converter / azkar pages (built in code) ===== -->
                <ScrollViewer x:Name="PageCalendar" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                    <StackPanel x:Name="PanelCalendar" Padding="0,8,0,20" HorizontalAlignment="Center" FlowDirection="RightToLeft" />
                </ScrollViewer>
                <ScrollViewer x:Name="PageConvert" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                    <StackPanel x:Name="PanelConvert" Padding="0,8,0,20" HorizontalAlignment="Center" FlowDirection="RightToLeft" />
                </ScrollViewer>
                <ScrollViewer x:Name="PageAzkar" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                    <StackPanel x:Name="PanelAzkar" Padding="0,8,0,20" HorizontalAlignment="Center" FlowDirection="RightToLeft" />
                </ScrollViewer>

                <!-- ===== Settings page ===== -->
                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                    <StackPanel x:Name="PanelSettings" Spacing="10" Padding="0,8,0,20" HorizontalAlignment="Center" FlowDirection="RightToLeft">
                        <TextBlock Text="الإعدادات" FontSize="24" FontWeight="SemiBold" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="المظهر" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="الخلفية" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <RadioButton x:Name="RbMicaAlt" GroupName="bd" Content="Mica Alt" Tag="micaalt" Checked="Backdrop_Checked" MinWidth="0" />
                                    <RadioButton x:Name="RbMica" GroupName="bd" Content="Mica" Tag="mica" Checked="Backdrop_Checked" MinWidth="0" />
                                    <RadioButton x:Name="RbAcrylic" GroupName="bd" Content="Acrylic" Tag="acrylic" Checked="Backdrop_Checked" MinWidth="0" />
                                </StackPanel>
                                <TextBlock Text="السمة" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <RadioButton x:Name="RbThemeSys" GroupName="th" Content="حسب النظام" Tag="system" Checked="Theme_Checked" MinWidth="0" />
                                    <RadioButton x:Name="RbThemeLight" GroupName="th" Content="فاتح" Tag="light" Checked="Theme_Checked" MinWidth="0" />
                                    <RadioButton x:Name="RbThemeDark" GroupName="th" Content="غامق" Tag="dark" Checked="Theme_Checked" MinWidth="0" />
                                </StackPanel>
                                <TextBlock Text="يتأثر Mica وMica Alt بخلفية سطح المكتب، أما Acrylic فهو شفاف مع تمويه. يمكن أن تتبع السمة النظام أو تُحدَّد يدويًا."
                                           TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="الموقع" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="الدولة" FontWeight="SemiBold" />
                                <ComboBox x:Name="CmbCountry" HorizontalAlignment="Stretch" SelectionChanged="Country_Changed" />
                                <TextBlock Text="المدن المصرية" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <ComboBox x:Name="CmbCity" HorizontalAlignment="Stretch" SelectionChanged="City_Changed" />
                                <TextBlock Text="البحث عن أي مدينة أو منطقة (في الدولة المختارة أو في كل العالم)" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtSearch" PlaceholderText="اسم المنطقة أو المدينة" KeyDown="Search_KeyDown" />
                                    <Button Grid.Column="1" Content="بحث" Click="Search_Click" />
                                </Grid>
                                <ListView x:Name="LstPlaces" MaxHeight="200" Visibility="Collapsed" SelectionChanged="Place_Selected" />
                                <StackPanel Orientation="Vertical" Spacing="6" Margin="0,6,0,0">
                                    <Button Content="تحديد موقعي تلقائيًا" Click="Detect_Click" />
                                    <TextBlock x:Name="TxtDetect" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="إحداثيات يدوية" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Spacing="8" FlowDirection="LeftToRight" HorizontalAlignment="Center">
                                    <TextBox x:Name="TxtLat" Width="110" PlaceholderText="Latitude" />
                                    <TextBox x:Name="TxtLon" Width="110" PlaceholderText="Longitude" />
                                    <Button Content="تطبيق" Click="Coords_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="التوقيت الصيفي" FontSize="16" FontWeight="SemiBold" />
                                <StackPanel Orientation="Vertical" Spacing="2">
                                    <RadioButton x:Name="RbDstAuto" GroupName="dst" Content="تلقائي" Tag="auto" Checked="Dst_Checked" MinWidth="0" />
                                    <RadioButton x:Name="RbDstOff" GroupName="dst" Content="إيقاف (UTC+2)" Tag="off" Checked="Dst_Checked" MinWidth="0" />
                                    <RadioButton x:Name="RbDstOn" GroupName="dst" Content="تشغيل (UTC+3)" Tag="on" Checked="Dst_Checked" MinWidth="0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="ويدجت سطح المكتب" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="نافذة صغيرة عائمة تعرض الصلاة القادمة والعدّاد، يمكن تحريكها بالسحب وتثبيتها فوق النوافذ." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ToggleSwitch x:Name="TglWidget" OnContent="ظاهر" OffContent="مخفي" Toggled="Widget_Toggled" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="الإشعارات" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="إشعار عند دخول وقت كل صلاة: حان الآن موعد أذان ..." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ToggleSwitch x:Name="TglAdhan" OnContent="مفعّل" OffContent="متوقف" Toggled="Adhan_Toggled" />
                                <StackPanel x:Name="PanelSounds" Spacing="10" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="الإقامة" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="مدة الانتظار بين الأذان والإقامة لكل صلاة (بالدقائق)" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel x:Name="PanelIqama" Spacing="8" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="التحديثات" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="يُفحص أحدث إصدار مستقر على GitHub عند الضغط فقط، ويُفتح رابط التنزيل في المتصفح." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Name="BtnUpdate" Content="التحقق من التحديثات" Click="Update_Click" HorizontalAlignment="Stretch" />
                                <TextBlock x:Name="TxtUpdate" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="التشغيل" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="تشغيل البرنامج مع بدء ويندوز" FontWeight="SemiBold" />
                                <ToggleSwitch x:Name="TglStartup" OnContent="مفعّل" OffContent="متوقف" Toggled="Startup_Toggled" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== About page ===== -->
                <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                    <StackPanel x:Name="PanelAbout" Spacing="10" Padding="0,8,0,20" HorizontalAlignment="Center" FlowDirection="RightToLeft">
                        <TextBlock Text="عن البرنامج" FontSize="24" FontWeight="SemiBold" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="20,28,20,28">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Image x:Name="ImgLogo" Width="88" Height="88" HorizontalAlignment="Center" />
                                <TextBlock Text="برنامج مواقيت الصلاة" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" />
                                <TextBlock x:Name="TxtVersion" Text="الإصدار 1.0" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="brought to you by app.instinct AI" FontSize="14" FlowDirection="LeftToRight" HorizontalAlignment="Center" TextAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="مصادر البيانات" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="المطور: محمد النجار" FontSize="13" />
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="المواقيت من Aladhan API بطريقة الحساب 5 (الهيئة المصرية العامة للمساحة). البحث عن الأماكن من Open-Meteo. تُخزَّن الإعدادات والمواقيت محليًا في AppData، فيعمل البرنامج دون اتصال بالإنترنت." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
