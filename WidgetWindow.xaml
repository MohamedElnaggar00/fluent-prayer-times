<Window
    x:Class="FluentPrayerTimes.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Surface" Background="Transparent" Padding="18,12,18,14"
          PointerPressed="Surface_PointerPressed" PointerMoved="Surface_PointerMoved" PointerReleased="Surface_PointerReleased">
        <StackPanel Spacing="2" FlowDirection="RightToLeft">
            <Grid>
                <TextBlock Text="الصلاة القادمة" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Left" FlowDirection="LeftToRight">
                    <ToggleButton x:Name="BtnPin" Width="30" Height="28" Padding="0" Click="Pin_Click" ToolTipService.ToolTip="تثبيت فوق كل النوافذ">
                        <FontIcon Glyph="&#xE718;" FontSize="13" />
                    </ToggleButton>
                    <Button Width="30" Height="28" Padding="0" Click="Close_Click" ToolTipService.ToolTip="إخفاء">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="TxtName" Text="--" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="TxtTime" Text="" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,4" FlowDirection="LeftToRight"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="TxtCount" Text="--:--:--" FontSize="36" FontWeight="SemiBold" FlowDirection="LeftToRight"
                       HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
