<Window
    x:Class="FluentPrayerTimes.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Surface" Background="Transparent" Padding="8,5,8,6"
          PointerPressed="Surface_PointerPressed" PointerMoved="Surface_PointerMoved" PointerReleased="Surface_PointerReleased">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" FlowDirection="LeftToRight" Margin="0,0,0,2" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                <ToggleButton x:Name="BtnPin" Width="18" Height="16" MinWidth="0" MinHeight="0" Padding="0" Click="Pin_Click" ToolTipService.ToolTip="تثبيت فوق كل النوافذ">
                    <FontIcon Glyph="&#xE718;" FontSize="8" />
                </ToggleButton>
                <Button Width="18" Height="16" MinWidth="0" MinHeight="0" Padding="0" Click="Close_Click" ToolTipService.ToolTip="إخفاء">
                    <FontIcon Glyph="&#xE711;" FontSize="7" />
                </Button>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="الصلاة القادمة" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"
                       FlowDirection="RightToLeft" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <StackPanel Grid.Row="1" Spacing="0" FlowDirection="RightToLeft">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock x:Name="TxtName" Text="--" FontSize="13" FontWeight="SemiBold" />
                <TextBlock x:Name="TxtTime" Text="" FontSize="8" VerticalAlignment="Bottom" Margin="0,0,0,2" FlowDirection="LeftToRight"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="TxtCount" Text="--:--:--" FontSize="19" FontWeight="SemiBold" FlowDirection="LeftToRight"
                       HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
