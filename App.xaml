<Application
    x:Class="FluentPrayerTimes.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#00C4CC</Color>
            <Color x:Key="SystemAccentColorDark1">#00A3AA</Color>
            <Color x:Key="SystemAccentColorDark2">#008289</Color>
            <Color x:Key="SystemAccentColorDark3">#006268</Color>
            <Color x:Key="SystemAccentColorLight1">#1FD6DD</Color>
            <Color x:Key="SystemAccentColorLight2">#4DE6EC</Color>
            <Color x:Key="SystemAccentColorLight3">#7FF3F7</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
